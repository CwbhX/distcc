HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME")
                          or os.path.join(HOME, ".config"), "distcc-mirror")
DEFAULT_PREFIX = os.path.join(HOME, ".local", "distcc-mirror")
DEFAULT_PORT = 3634
LABEL_BASE = "local.distcc-mirror.distccd"
WHITELIST = ("cc", "c++", "gcc", "g++", "clang", "clang++")
BREW = "/opt/homebrew"

# Keys the tool interprets; every other key in a config is exported to the
# build as is (CCACHE_PREFIX, ...).
KNOWN_KEYS = {
    "ROOTS", "BUILD_DIR", "EXCLUDE", "EXTRA", "HELPERS", "LOCAL_JOBS",
    "PORT", "CLIENT_ADDR", "PREFIX", "PATHMAP", "INSTALLED", "RSH",
    "DAEMON_ARGS",
}


# ---------------------------------------------------------------- output

_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def _c(code, text):
    return "\033[%sm%s\033[0m" % (code, text) if _COLOR else text


def info(msg):
    print(msg, flush=True)


def step(msg):
    print(_c("1", "==> ") + _c("1", msg), flush=True)


def die(msg, code=1):
    print(_c("31", "error: ") + msg, file=sys.stderr)
    sys.exit(code)


class Report:
    """Collects ok / warning / problem lines for doctor and friends."""

    def __init__(self):
        self.problems = 0
        self.warnings = 0

    def ok(self, msg):
        info("  %s %s" % (_c("32", "ok"), msg))

    def warn(self, msg, fix=None):
        self.warnings += 1
        info("  %s %s" % (_c("33", "!!"), msg))
        if fix:
            info("     " + _c("2", "-> " + fix))

    def fail(self, msg, fix=None):
        self.problems += 1
        info("  %s %s" % (_c("31", "XX"), msg))
        if fix:
            info("     " + _c("2", "-> " + fix))


# ---------------------------------------------------------------- helpers

def tilde(path):
    """Shorten a path under $HOME to ~/... for display and configs."""
    if path == HOME:
        return "~"
    if path.startswith(HOME + "/"):
        return "~" + path[len(HOME):]
    return path


def home_relative(path):
    """A path as rsync/ssh want it on another machine: relative to the
    home directory when it is under ours, else absolute."""
    if path.startswith(HOME + "/"):
        return path[len(HOME) + 1:]
    return path


def split_colon(value):
    return [p for p in (value or "").split(":") if p]


def under(path, root):
    path, root = path.rstrip("/"), root.rstrip("/")
    return path == root or path.startswith(root + "/")


def ncpu():
    return os.cpu_count() or 4


def run(cmd, **kw):
    """Run a command, echoing it; exit if it fails."""
    info(_c("2", "$ " + " ".join(shlex.quote(c) for c in cmd)))
    r = subprocess.run(cmd, **kw)
    if r.returncode != 0:
        die("%s failed (exit %d)" % (cmd[0], r.returncode), r.returncode)
    return r


# ---------------------------------------------------------------- config

def _expand(value, values):
    def var(m):
        name = m.group(1) or m.group(2)
        return values.get(name, os.environ.get(name, m.group(0)))
    value = re.sub(r"\$\{(\w+)\}|\$(\w+)", var, value)
    return re.sub(r"(^|[:= ])~(?=/|$|[: ])",
                  lambda m: m.group(1) + HOME, value)


def parse_config_file(path):
    values = {}
    with open(path) as f:
        for n, line in enumerate(f, 1):
            s = line.strip()
            if not s or s.startswith("#"):
                continue
            if s.startswith("export "):
                s = s[7:].lstrip()
            m = re.match(r"([A-Za-z_][A-Za-z0-9_]*)=(.*)$", s)
            if not m:
                die("%s:%d: expected KEY=VALUE" % (path, n))
            try:
                parts = shlex.split(m.group(2), comments=True)
            except ValueError as e:
                die("%s:%d: %s" % (path, n, e))
            values[m.group(1)] = _expand(" ".join(parts), values)
    return values


class Helper:
    def __init__(self, spec, port):
        m = re.match(r"^([^=/\s]+)(?:=([^/\s]+))?(?:/(\d+))?$", spec)
        if not m:
            die("bad helper %r: expected ssh-name[=address][/slots]" % spec)
        self.ssh = m.group(1)
        self.addr = m.group(2) or ssh_hostname(m.group(1))
        self.jobs = int(m.group(3) or 8)
        self.port = port

    def spec(self):
        return "%s=%s/%d" % (self.ssh, self.addr, self.jobs)

    def hostspec(self):
        return "%s:%d/%d,mirror" % (self.addr, self.port, self.jobs)


class Config:
    def __init__(self, path):
        self.path = path
        self.name = os.path.basename(path)[:-len(".conf")]
        v = self.values = parse_config_file(path)
        self.roots = [os.path.abspath(r)
                      for r in split_colon(v.get("ROOTS") or v.get("ROOT"))]
        self.build_dir = os.path.abspath(v["BUILD_DIR"]) \
            if v.get("BUILD_DIR") else ""
        self.exclude = v.get("EXCLUDE", ".git")
        self.extra = split_colon(v.get("EXTRA"))
        self.prefix = os.path.abspath(v.get("PREFIX") or DEFAULT_PREFIX)
        self.port = int(v.get("PORT") or DEFAULT_PORT)
        self.local_jobs = int(v.get("LOCAL_JOBS") or ncpu() + 2)
        self.client_addr = v.get("CLIENT_ADDR", "")
        self.installed = v.get("INSTALLED", "")
        self.rsh = v.get("RSH", "")
        self.daemon_args = shlex.split(v.get("DAEMON_ARGS", ""))
        self.helpers = [Helper(h, self.port)
                        for h in v.get("HELPERS", "").split()]
        if "PATHMAP" in v:
            self.pathmap = v["PATHMAP"]
        elif self.build_dir:
            # The build dir as written (logical) is what the helpers have;
            # where it really is here (physical) may differ, e.g. through a
            # symlink to another disk.  Mapping it, even onto itself, also
            # marks it as a build tree: only sources, headers and PCHs in it
            # are synced and compared.
            self.pathmap = "%s=%s" % (os.path.realpath(self.build_dir),
                                      self.build_dir)
        else:
            self.pathmap = ""
        self.extra_env = {k: val for k, val in v.items()
                          if k not in KNOWN_KEYS and k != "ROOT"}
        if not self.roots:
            die("%s: ROOTS is not set" % path)
        if not self.helpers:
            die("%s: HELPERS is not set" % path)

    def bindir(self):
        return os.path.join(self.prefix, "bin")

    def distcc(self):
        return os.path.join(self.bindir(), "distcc")

    def total_jobs(self):
        return self.local_jobs + sum(h.jobs for h in self.helpers)

    def hosts(self):
        return " ".join([h.hostspec() for h in self.helpers]
                        + ["localhost/%d" % self.local_jobs])

    def env(self):
        """The variables the build needs (PATH first)."""
        e = {}
        path = os.environ.get("PATH", "")
        parts = [p for p in path.split(":") if p and p != self.bindir()]
        e["PATH"] = ":".join([self.bindir()] + parts)
        e["DISTCC_HOSTS"] = self.hosts()
        e["DISTCC_MIRROR_ROOTS"] = ":".join(self.roots)
        e["DISTCC_MIRROR_EXCLUDE"] = self.exclude
        if self.pathmap:
            e["DISTCC_MIRROR_PATHMAP"] = self.pathmap
        if self.extra:
            e["DISTCC_MIRROR_EXTRA"] = ":".join(self.extra)
        e["DISTCC_MIRROR_SSH"] = " ".join(h.ssh for h in self.helpers)
        if self.installed:
            e["DISTCC_MIRROR_INSTALLED"] = self.installed
        if self.rsh:
            e["DISTCC_MIRROR_RSH"] = self.rsh
        e.update(self.extra_env)
        return e

    def full_env(self):
        e = dict(os.environ)
        e.update(self.env())
        return e


def all_config_paths():
    return sorted(glob.glob(os.path.join(CONFIG_DIR, "*.conf")))


def config_path_for(name):
    if os.sep in name or name.endswith(".conf"):
        return os.path.abspath(os.path.expanduser(name))
    return os.path.join(CONFIG_DIR, name + ".conf")


def load_config(args, required=True):
    """The config named by -c, $DISTCC_MIRROR_CONFIG, the only one there is,
    or the one whose roots contain the current directory."""
    name = getattr(args, "config", None) or os.environ.get(
        "DISTCC_MIRROR_CONFIG")
    if name:
        path = config_path_for(name)
        if not os.path.exists(path):
            die("no config %s" % tilde(path))
        return Config(path)
    paths = all_config_paths()
    if not paths:
        if not required:
            return None
        die("no config in %s; create one with: distcc-mirror init"
            % tilde(CONFIG_DIR))
    if len(paths) == 1:
        return Config(paths[0])
    here = [os.getcwd(), os.environ.get("PWD", "")]
    matches = []
    for p in paths:
        cfg = Config(p)
        dirs = cfg.roots + ([cfg.build_dir, os.path.realpath(cfg.build_dir)]
                            if cfg.build_dir else [])
        if any(h and under(h, d) for h in here for d in dirs):
            matches.append(cfg)
    if len(matches) == 1:
        return matches[0]
    if not required:
        return None
    die("several configs (%s); pick one with -c NAME or run from inside a "
        "project" % ", ".join(os.path.basename(p)[:-5] for p in paths))


# ---------------------------------------------------------------- ssh

def ssh_base(rsh=""):
    return (shlex.split(rsh) if rsh else ["ssh"]) + [
        "-o", "BatchMode=yes", "-o", "ConnectTimeout=10"]


def ssh_hostname(name):
    """The address ssh connects to for @p name (ssh_config aliases)."""
    try:
        out = subprocess.run(["ssh", "-G", name], capture_output=True,
                             text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return name
    for line in out.splitlines():
        if line.startswith("hostname "):
            return line.split(None, 1)[1].strip()
    return name


def remote(cfg_or_rsh, host, script, args=(), capture=True):
    """Run a bash script on @p host with @p args; returns CompletedProcess."""
    rsh = cfg_or_rsh.rsh if isinstance(cfg_or_rsh, Config) else cfg_or_rsh
    cmd = ssh_base(rsh) + [host, "bash -s -- "
                           + " ".join(shlex.quote(a) for a in args)]
    return subprocess.run(cmd, input=script, text=True,
                          capture_output=capture)


def local_script(script, args=()):
    return subprocess.run(["bash", "-s", "--"] + list(args), input=script,
                          text=True, capture_output=True)


def port_open(addr, port, timeout=2.0):
    try:
        with socket.create_connection((addr, port), timeout=timeout):
            return True
    except OSError:
        return False


def label(port):
    return "%s.%d" % (LABEL_BASE, port)


# ---------------------------------------------------------------- facts

# Prints what doctor and brew-parity compare, as key=value lines.  The same
# script runs here and on each helper.  Arguments: PREFIX PORT LABEL DIR...
FACTS_SH = r'''
P="$1"; PORT="$2"; LABEL="$3"; shift 3
case "$P" in /*) ;; *) P="$HOME/$P";; esac
echo "home=$HOME"
echo "os=$(sw_vers -productVersion 2>/dev/null || uname -sr)"
echo "arch=$(uname -m)"
echo "ncpu=$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null)"
for b in distcc distccd; do
  if [ -x "$P/bin/$b" ]; then
    echo "$b=$(shasum -a 256 "$P/bin/$b" | cut -d' ' -f1)"
  else
    echo "$b=missing"
  fi
done
echo "whitelist=$(ls "$P/lib/distcc" 2>/dev/null | tr '\n' ' ')"
dev=$(xcode-select -p 2>/dev/null)
echo "devdir=$dev"
if [ -n "$dev" ] && [ -x "$dev/usr/bin/clang" ]; then
  echo "clang=$(shasum -a 256 "$dev/usr/bin/clang" | cut -d' ' -f1)"
  echo "clang_version=$("$dev/usr/bin/clang" --version 2>/dev/null | head -1)"
fi
echo "clt=$(pkgutil --pkg-info=com.apple.pkg.CLTools_Executables 2>/dev/null | awk '/^version:/{print $2}')"
echo "sdk=$(xcrun --show-sdk-version 2>/dev/null)"
for d in "$@"; do
  if [ -d "$d" ]; then echo "dir_ok=$d"; else echo "dir_missing=$d"; fi
done
if command -v launchctl >/dev/null 2>&1; then
  st=$(launchctl print "gui/$(id -u)/$LABEL" 2>/dev/null | awk '$1=="state"{print $3; exit}')
  echo "agent=${st:-none}"
fi
ps -axo pid=,command= 2>/dev/null | grep '[d]istccd' | grep -- "--port $PORT" \
  | head -1 | sed 's/^ */daemon=/'
B=/opt/homebrew
if [ -d "$B/opt" ]; then
  for o in "$B"/opt/*; do
    t=$(readlink "$o") || continue
    case "$t" in *Cellar/*) echo "keg=${t#*Cellar/}";; esac
  done | sort -u
  for k in "$B"/Cellar/*/*; do
    [ -d "$k" ] && echo "cellar=${k#"$B"/Cellar/}"
  done
  for l in "$B"/var/homebrew/linked/* "$B"/var/homebrew/pinned/*; do
    [ -e "$l" ] || [ -L "$l" ] || continue
    case "$l" in */linked/*) echo "linked=${l##*/}";; *) echo "pinned=${l##*/}";; esac
  done
  echo "include=$(ls "$B/include" 2>/dev/null | tr '\n' ' ')"
fi
'''


class Facts:
    def __init__(self, text):
        self.lists = {}
        for line in text.splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                self.lists.setdefault(k, []).append(v)

    def get(self, key, default=""):
        v = self.lists.get(key)
        return v[0] if v else default

    def all(self, key):
        return self.lists.get(key, [])

    def cellar(self):
        """{"name/version"} of every keg in the Cellar, active or not."""
        return set(self.all("cellar"))

    def kegs(self):
        """{name: version} of the kegs the opt links point to."""
        out = {}
        for k in self.all("keg"):
            name, _, ver = k.partition("/")
            if ver:
                out[name] = ver.split("/")[0]
        return out


def facts_args(cfg, dirs):
    return [home_relative(cfg.prefix), str(cfg.port), label(cfg.port)] \
        + list(dirs)


def local_facts(cfg, dirs=()):
    return Facts(local_script(FACTS_SH, facts_args(cfg, dirs)).stdout)


def helper_facts(cfg, helper, dirs=()):
    r = remote(cfg, helper.ssh, FACTS_SH, facts_args(cfg, dirs))
    if r.returncode != 0 and "home=" not in r.stdout:
        return None, (r.stderr.strip() or "ssh failed")
    return Facts(r.stdout), None


# ---------------------------------------------------------------- install

def source_dir(args):
    if args.source:
        d = os.path.abspath(args.source)
    else:
        d = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    if not os.path.exists(os.path.join(d, "src", "distcc.c")):
        die("not a distcc source tree: %s (give --source DIR)" % d)
    return d


def make_whitelist(prefix):
    wl = os.path.join(prefix, "lib", "distcc")
    os.makedirs(wl, exist_ok=True)
    for c in WHITELIST:
        p = os.path.join(wl, c)
        if os.path.islink(p) or os.path.exists(p):
            os.remove(p)
        os.symlink("../../bin/distcc", p)


def copy_prefix_to(prefix, ssh, rsh=""):
    rel = home_relative(prefix)
    r = subprocess.run(ssh_base(rsh) + [ssh, "mkdir -p " + shlex.quote(rel)])
    if r.returncode != 0:
        return False
    cmd = ["rsync", "-a"]
    if rsh:
        cmd += ["-e", rsh]
    cmd += [prefix + "/", "%s:%s/" % (ssh, rel)]
    info(_c("2", "$ " + " ".join(shlex.quote(c) for c in cmd)))
    return subprocess.run(cmd).returncode == 0


def cmd_install(args):
    src = source_dir(args)
    cfg = load_config(args, required=False)
    prefix = os.path.abspath(os.path.expanduser(
        args.prefix or (cfg.prefix if cfg else DEFAULT_PREFIX)))
    if args.helper:
        helpers = args.helper
    elif cfg and not args.local_only:
        helpers = [h.ssh for h in cfg.helpers]
    else:
        helpers = []
    rsh = cfg.rsh if cfg else ""

    if not args.no_build:
        step("Building distcc in %s" % tilde(src))
        if not os.path.exists(os.path.join(src, "configure")):
            run(["./autogen.sh"], cwd=src)
        current = ""
        mk = os.path.join(src, "Makefile")
        if os.path.exists(mk):
            with open(mk) as f:
                for line in f:
                    if line.startswith("prefix = "):
                        current = line.split("=", 1)[1].strip()
                        break
        if current != prefix:
            conf = ["./configure", "--prefix=" + prefix]
            if not args.pump:
                conf.append("--disable-pump-mode")
            run(conf, cwd=src)
        make = ["make", "-j%d" % ncpu()]
        if platform.system() == "Darwin" and shutil.which("brew"):
            popt = subprocess.run(["brew", "--prefix", "popt"],
                                  capture_output=True, text=True).stdout.strip()
            static = os.path.join(popt, "lib", "libpopt.a")
            if popt and os.path.exists(static):
                # Static popt: the binaries then run on a helper without
                # Homebrew's popt.
                make.append("LIBS=%s -liconv" % static)
        run(make, cwd=src)
        run(["make", "install"], cwd=src, stdout=subprocess.DEVNULL)

    step("Installing into %s" % tilde(prefix))
    if not os.path.exists(os.path.join(prefix, "bin", "distccd")):
        die("%s/bin/distccd is missing; run without --no-build" % prefix)
    make_whitelist(prefix)
    me = os.path.realpath(__file__)
    dest = os.path.join(prefix, "bin", "distcc-mirror")
    if os.path.realpath(dest) != me:
        shutil.copy2(me, dest)
    info("  distcc, distccd, distcc-mirror and the compiler whitelist "
         "(%s)" % ", ".join(WHITELIST))

    for h in helpers:
        step("Copying to %s" % h)
        if not copy_prefix_to(prefix, h, rsh):
            die("copy to %s failed" % h)
        if cfg:
            lab = label(cfg.port)
            r = remote(cfg, h, 'launchctl print "gui/$(id -u)/%s" >/dev/null '
                       '2>&1 && launchctl kickstart -k "gui/$(id -u)/%s" '
                       '&& echo restarted' % (lab, lab))
            if "restarted" in r.stdout:
                info("  restarted the helper daemon on %s" % h)
            else:
                info("  no LaunchAgent on %s yet: distcc-mirror helper "
                     "install" % h)

    path_dirs = os.environ.get("PATH", "").split(":")
    info("")
    info("Done.  Add %s to PATH:" % tilde(os.path.join(prefix, "bin")))
    if os.path.join(prefix, "bin") not in path_dirs:
        info('  echo \'export PATH="%s:$PATH"\' >> ~/.zshrc'
             % os.path.join(prefix, "bin").replace(HOME, "$HOME"))
    if not cfg:
        info("Next: distcc-mirror init --helper HOST --build BUILD_DIR")


# ---------------------------------------------------------------- init

def git_toplevel(d):
    r = subprocess.run(["git", "-C", d, "rev-parse", "--show-toplevel"],
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def cmake_launcher(build_dir):
    cache = os.path.join(build_dir, "CMakeCache.txt")
    if not os.path.exists(cache):
        return None
    with open(cache, errors="replace") as f:
        for line in f:
            if line.startswith("CMAKE_CXX_COMPILER_LAUNCHER:"):
                return line.split("=", 1)[1].strip()
    return ""


def cmd_init(args):
    cwd = os.environ.get("PWD") or os.getcwd()
    if os.path.realpath(cwd) != os.path.realpath(os.getcwd()):
        cwd = os.getcwd()
    root = os.path.abspath(os.path.expanduser(args.root)) if args.root \
        else (git_toplevel(cwd) or cwd)
    if args.build:
        # Kept as written (not resolved): the helpers have the tree at the
        # logical path.
        b = os.path.expanduser(args.build)
        if os.path.isabs(b):
            build = os.path.normpath(b)
        elif os.path.exists(b):
            build = os.path.normpath(os.path.join(cwd, b))
        else:
            build = os.path.normpath(os.path.join(root, b))
    elif os.path.exists(os.path.join(cwd, "build.ninja")):
        build = cwd
    else:
        cands = [d for d in sorted(glob.glob(os.path.join(root, "*")))
                 if os.path.exists(os.path.join(d, "build.ninja"))]
        if len(cands) != 1:
            die("cannot tell which build directory to use (%s); give "
                "--build DIR" % (", ".join(os.path.basename(c) for c in cands)
                                 or "none found"))
        build = cands[0]
    if not os.path.isdir(build):
        die("build directory %s does not exist" % build)
    if not under(build, root):
        die("the build directory %s is not under the root %s"
            % (tilde(build), tilde(root)))
    name = args.name or os.path.basename(root).lower()
    path = config_path_for(name)
    if os.path.exists(path) and not args.force:
        die("%s exists (use --force to replace it)" % tilde(path))
    if not args.helper:
        die("give at least one --helper SSH_NAME")
    port = args.port or DEFAULT_PORT

    step("Looking at the helpers")
    helpers, client_addr = [], args.client_addr or ""
    for spec in args.helper:
        m = re.match(r"^([^=/\s]+)(?:=([^/\s]+))?(?:/(\d+))?$", spec)
        if not m:
            die("bad --helper %r: expected ssh-name[=address][/slots]" % spec)
        ssh, addr, jobs = m.groups()
        addr = addr or ssh_hostname(ssh)
        if not jobs or not client_addr:
            r = remote("", ssh, 'echo "ncpu=$(sysctl -n hw.ncpu 2>/dev/null '
                       '|| nproc)"; echo "client=${SSH_CONNECTION%% *}"')
            if r.returncode != 0:
                die("cannot ssh to %s: %s" % (ssh, r.stderr.strip()))
            f = Facts(r.stdout)
            jobs = jobs or str(int(f.get("ncpu", "6")) + 2)
            client_addr = client_addr or f.get("client")
        helpers.append("%s=%s/%s" % (ssh, addr, jobs))
        info("  %s: address %s, %s slots" % (ssh, addr, jobs))
    info("  this machine, as the helpers see it: %s" % client_addr)

    excludes = [".git"]
    for d in sorted(glob.glob(os.path.join(root, "*"))):
        if (os.path.isdir(d) and not under(build, d)
                and os.path.exists(os.path.join(d, "CMakeCache.txt"))):
            excludes.append(os.path.basename(d))      # other build trees
    excludes += [e for x in (args.exclude or []) for e in split_colon(x)]
    extra = [os.path.abspath(os.path.expanduser(e))
             for x in (args.extra or []) for e in split_colon(x)]
    local_jobs = args.local_jobs or ncpu() + 2
    prefix = os.path.abspath(os.path.expanduser(args.prefix or DEFAULT_PREFIX))

    env = {}
    for kv in args.set or []:
        if "=" not in kv:
            die("--set wants KEY=VALUE, not %r" % kv)
        k, v = kv.split("=", 1)
        env[k] = v
    launcher = cmake_launcher(build)
    notes = []
    if launcher and "ccache" in launcher and "CCACHE_PREFIX" not in env:
        env["CCACHE_PREFIX"] = os.path.join(prefix, "bin", "distcc")
    elif launcher == "":
        notes.append("The build has no compiler launcher.  Reconfigure it "
                     "with\n    cmake -DCMAKE_C_COMPILER_LAUNCHER=distcc "
                     "-DCMAKE_CXX_COMPILER_LAUNCHER=distcc %s" % tilde(build))

    lines = [
        "# distcc-mirror config for %s (written by distcc-mirror init on %s)."
        % (name, time.strftime("%Y-%m-%d")),
        "# KEY=VALUE lines; ~ and $VARS are expanded.  Keys not listed here",
        "# are exported to the build as they are.",
        "",
        "# Source trees, copied to the helpers and compiled in place there",
        "# (colon-separated; same paths on every machine).",
        "ROOTS=%s" % tilde(root),
        "# Where ninja runs.  Only sources, headers and PCHs in it are synced.",
        "BUILD_DIR=%s" % tilde(build),
        "# Names at the top of each root that are neither copied nor compared.",
        "EXCLUDE=%s" % ":".join(excludes),
        "# More trees to copy whole, e.g. dependencies built locally.",
        "EXTRA=%s" % ":".join(tilde(e) for e in extra),
        "# Helpers: ssh-name=address/slots, space-separated.",
        "HELPERS=\"%s\"" % " ".join(helpers),
        "# Compile slots on this machine.",
        "LOCAL_JOBS=%d" % local_jobs,
        "# Port of the mirror daemon on the helpers.",
        "PORT=%d" % port,
        "# This machine's address as the helpers see it (their --allow).",
        "CLIENT_ADDR=%s" % client_addr,
        "# Where distcc is installed, on every machine.",
        "PREFIX=%s" % tilde(prefix),
    ]
    if env:
        lines += ["", "# Exported to the build:"]
        lines += ["%s=%s" % (k, tilde(v) if re.match(r"^[\w@%+=:,./~-]*$",
                                                   tilde(v))
                             else shlex.quote(v)) for k, v in env.items()]
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
    step("Wrote %s" % tilde(path))
    info("\n".join("  " + l for l in lines if l and not l.startswith("#")))
    for n in notes:
        info("\nNote: " + n)
    info("\nNext:\n  distcc-mirror helper install    # start the daemon on "
         "the helpers\n  distcc-mirror doctor\n  distcc-mirror build")


