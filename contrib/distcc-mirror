    for i in $(seq 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
    rm -f "$pf"
    echo "stopped the daemon that was started by hand (pid $pid)"
  fi
}
case "$ACTION" in
install)
  [ -x "$PREFIX/bin/distccd" ] || { echo "$PREFIX/bin/distccd is missing: run distcc-mirror install" >&2; exit 3; }
  mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
  # distccd refuses a --mirror-root that does not exist; the sync fills it.
  for r in "$@"; do mkdir -p "$r"; done
  unload
  stop_by_hand
  cat > "$PLIST"
  launchctl bootstrap "gui/$uid" "$PLIST" || exit 4
  echo "loaded $LABEL"
  for i in $(seq 50); do
    lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1 && { echo "listening on port $PORT"; exit 0; }
    sleep 0.2
  done
  echo "not listening on port $PORT after 10s; log:" >&2
  tail -n 15 "$LOG" >&2
  exit 5;;
start)
  [ -f "$PLIST" ] || { echo "not installed: distcc-mirror helper install" >&2; exit 3; }
  if loaded; then launchctl kickstart "gui/$uid/$LABEL"; else launchctl bootstrap "gui/$uid" "$PLIST"; fi && echo "started";;
stop) unload; echo "stopped";;
restart) launchctl kickstart -k "gui/$uid/$LABEL" && echo "restarted";;
uninstall) unload; rm -f "$PLIST"; echo "removed $LABEL";;
status)
  launchctl print "gui/$uid/$LABEL" 2>/dev/null \
    | awk '/^\t(state|pid|runs|last exit code) = /{sub(/^\t/, ""); print "  agent " $0}'
  loaded || echo "  agent: not installed"
  ps -axo pid=,etime=,command= | grep '[d]istccd' | grep -- "--port $PORT" | head -1 | awk '{print "  daemon pid " $1 ", up " $2}'
  n=$(ps -axo command= | grep '[d]istccd' | grep -c -- "--port $PORT")
  echo "  processes: $n"
  [ -f "$LOG" ] && { echo "  last log lines:"; tail -n 5 "$LOG" | sed 's/^/    /'; };;
log) tail -n "${1:-50}" "$LOG";;
esac
'''


def log_name(port):
    if port == DEFAULT_PORT:
        return "distccd-mirror.log"
    return "distccd-mirror-%d.log" % port


def agent_action(cfg, h, action, stdin_extra="", extra=()):
    args = [action, label(cfg.port), home_relative(cfg.prefix),
            str(cfg.port), log_name(cfg.port)] + list(extra)
    if stdin_extra:
        # The script goes on the command line so that stdin can carry the
        # plist, for "cat > $PLIST".
        cmd = ssh_base(cfg.rsh) + [h.ssh, "bash -c " + shlex.quote(
            AGENT_SH) + " -- " + " ".join(shlex.quote(a) for a in args)]
        return subprocess.run(cmd, input=stdin_extra, text=True,
                              capture_output=True)
    return remote(cfg, h.ssh, AGENT_SH, args)


def helper_install(cfg, h):
    r = remote(cfg, h.ssh, 'printf %s "$HOME"')
    if r.returncode != 0:
        die("cannot ssh to %s: %s" % (h.ssh, r.stderr.strip()))
    rhome = r.stdout.strip()
    rel = home_relative(cfg.prefix)
    rprefix = rel if rel.startswith("/") else rhome + "/" + rel
    roots, allows, jobs, extra = daemon_plan(cfg, h)
    argv = [rprefix + "/bin/distccd", "--daemon", "--no-detach",
            "--listen", h.addr, "--port", str(h.port), "--jobs", str(jobs),
            "--log-file", rhome + "/Library/Logs/" + log_name(h.port)]
    for a in allows:
        argv += ["--allow", a if "/" in a else a + "/32"]
    for root in roots:
        argv += ["--mirror-root", root]
    argv += extra
    plist = plistlib.dumps({
        "Label": label(h.port),
        "ProgramArguments": argv,
        # Errors before the log file is open (a bad option, a missing
        # root, a failed confinement probe) go to stderr.
        "StandardErrorPath": rhome + "/Library/Logs/" + log_name(h.port),
        "RunAtLoad": True,
        "KeepAlive": True,
        "ThrottleInterval": 10,
        "ProcessType": "Standard",
    }).decode()
    step("Installing the daemon on %s (LaunchAgent %s)"
         % (h.ssh, label(h.port)))
    info("  " + _c("2", " ".join(shlex.quote(a) for a in argv)))
    r = agent_action(cfg, h, "install", stdin_extra=plist, extra=roots)
    for line in (r.stdout + r.stderr).strip().splitlines():
        info("  " + line)
    if r.returncode != 0:
        die("installing on %s failed" % h.ssh)
    if port_open(h.addr, h.port, 3):
        info("  " + _c("32", "%s:%d answers from here" % (h.addr, h.port)))
    else:
        die("the daemon listens, but %s:%d does not answer from here "
            "(firewall, or the wrong --listen address?)" % (h.addr, h.port))


def cmd_helper(args):
    cfg = load_config(args)
    helpers = [h for h in cfg.helpers if not args.host or h.ssh in args.host]
    if not helpers:
        die("no such helper in %s" % tilde(cfg.path))
    for h in helpers:
        if args.action == "install":
            helper_install(cfg, h)
            continue
        if len(helpers) > 1 or args.action == "status":
            step("%s (%s:%d)" % (h.ssh, h.addr, h.port))
        extra = [str(args.lines)] if args.action == "log" else []
        r = agent_action(cfg, h, args.action, extra=extra)
        out = (r.stdout + r.stderr).rstrip()
        if out:
            info(out)
        if args.action == "status":
            ok = port_open(h.addr, h.port)
            info("  %s:%d from here: %s" % (
                h.addr, h.port, _c("32", "answers") if ok
                else _c("31", "no answer")))


# ---------------------------------------------------------------- brew

BREW_APPLY_SH = r'''
export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_CLEANUP=1 HOMEBREW_NO_ENV_HINTS=1
B=/opt/homebrew; brew=$B/bin/brew; rc=0
# Arguments: name version link(1/0) ...
while [ $# -ge 3 ]; do
  n=$1; v=$2; l=$3; shift 3
  [ -e "$B/var/homebrew/pinned/$n" ] && $brew unpin "$n" >/dev/null 2>&1
  [ -e "$B/var/homebrew/linked/$n" ] && $brew unlink "$n" >/dev/null 2>&1
  ln -sfn "../Cellar/$n/$v" "$B/opt/$n"
  if [ "$l" = 1 ]; then
    if out=$($brew link "$n" 2>&1); then echo "linked $n $v"; else echo "LINK FAILED $n: $out" | tail -2; rc=1; fi
  else
    echo "opt link for $n $v (not linked, as here)"
  fi
  $brew pin "$n" >/dev/null 2>&1 || true
done
exit $rc
'''


def cmd_brew_parity(args):
    cfg = load_config(args)
    if not os.path.isdir(BREW + "/Cellar"):
        die("no Homebrew in %s" % BREW)
    lf = local_facts(cfg)
    lk = lf.kegs()
    linked = set(lf.all("linked"))
    helpers = [h for h in cfg.helpers if not args.host or h.ssh in args.host]
    for h in helpers:
        step("Homebrew on %s compared with here" % h.ssh)
        hf, err = helper_facts(cfg, h)
        if hf is None:
            die("cannot ssh to %s: %s" % (h.ssh, err))
        hk = hf.kegs()
        hc = hf.cellar()
        miss = sorted(n for n in lk if n not in hk)
        diff = sorted(n for n in lk if n in hk and hk[n] != lk[n])
        extra = sorted(n for n in hk if n not in lk)
        # In the helper's Cellar already, only not active (no opt link).
        present = {n for n in miss + diff if "%s/%s" % (n, lk[n]) in hc}
        if args.only:
            only = {x for o in args.only for x in o.split(",")}
            miss = [n for n in miss if n in only]
            diff = [n for n in diff if n in only]
        info("  same:      %d" % (len(lk) - len(miss) - len(diff)))
        info("  missing:   %d%s" % (len(miss), (
            "  " + " ".join("%s %s%s" % (n, lk[n], " (no opt link)"
                                         if n in present else "")
                            for n in miss))
            if miss else ""))
        info("  different: %d%s" % (len(diff), (
            "  " + " ".join("%s %s (there %s)" % (n, lk[n], hk[n])
                            for n in diff)) if diff else ""))
        if extra:
            info("  only there: %d (left alone)" % len(extra))
        inc_l = set(lf.get("include").split())
        inc_h = set(hf.get("include").split())
        if inc_l != inc_h:
            info("  /opt/homebrew/include: only here: %s; only there: %s"
                 % (" ".join(sorted(inc_l - inc_h)) or "-",
                    " ".join(sorted(inc_h - inc_l)) or "-"))
        todo = miss + (diff if args.different else [])
        if not args.apply:
            if miss or diff:
                info("\nTo copy the missing kegs at this machine's versions "
                     "(then link and pin them):\n  distcc-mirror brew-parity "
                     "--apply%s" % ("" if not diff else
                                    "\nTo also replace the %d at other "
                                    "versions: add --different" % len(diff)))
            continue
        if not todo:
            info("  nothing to copy")
            continue
        copy = [n for n in todo if n not in present]
        if copy:
            step("Copying %d keg(s) to %s" % (len(copy), h.ssh))
            mk = " ".join(shlex.quote("%s/Cellar/%s" % (BREW, n))
                          for n in copy)
            if remote(cfg, h.ssh, "mkdir -p " + mk,
                      capture=False).returncode:
                die("mkdir on %s failed" % h.ssh)
        for n in copy:
            src = "%s/Cellar/%s/%s" % (BREW, n, lk[n])
            cmd = ["rsync", "-a"] + (["-e", cfg.rsh] if cfg.rsh else []) + [
                src, "%s:%s/Cellar/%s/" % (h.ssh, BREW, n)]
            if subprocess.run(cmd).returncode != 0:
                die("copying %s failed" % n)
            info("  copied %s %s" % (n, lk[n]))
        step("Linking and pinning on %s" % h.ssh)
        argv = []
        for n in todo:
            argv += [n, lk[n], "1" if n in linked else "0"]
        r = remote(cfg, h.ssh, BREW_APPLY_SH, argv)
        for line in (r.stdout + r.stderr).strip().splitlines():
            info("  " + line)
        if r.returncode != 0:
            info(_c("33", "  some links failed (see above); a conflicting "
                    "file in /opt/homebrew usually needs a look by hand"))
        info("Pinned, so brew upgrade leaves them alone.  Upgrade both "
             "machines together.")


# ---------------------------------------------------------------- main

def main():
    p = argparse.ArgumentParser(
        prog="distcc-mirror",
        description=__doc__.split("\n\n", 1)[0],
        epilog=__doc__.split("\n\n", 1)[1],
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("-c", "--config", metavar="NAME",
                   help="config name or file (default: the one for the "
                   "current directory)")
    sub = p.add_subparsers(dest="cmd", metavar="COMMAND")

    s = sub.add_parser("install", help="build and install distcc here and "
                       "on the helpers")
    s.add_argument("--prefix", help="install prefix (default %s)"
                   % tilde(DEFAULT_PREFIX))
    s.add_argument("--source", help="distcc source tree (default: the one "
                   "this script is in)")
    s.add_argument("--helper", action="append", metavar="SSH",
                   help="also copy to this helper (repeatable; default: the "
                   "config's helpers)")
    s.add_argument("--local-only", action="store_true",
                   help="do not copy to the helpers")
    s.add_argument("--no-build", action="store_true",
                   help="only install and copy what is already built")
    s.add_argument("--pump", action="store_true",
                   help="also build pump mode (needs Python setuptools)")
    s.set_defaults(fn=cmd_install)

    s = sub.add_parser("init", help="write a config for a project")
    s.add_argument("--helper", action="append", metavar="SSH[=ADDR][/SLOTS]",
                   help="a helper, by its ssh name (repeatable)")
    s.add_argument("--build", metavar="DIR", help="build directory "
                   "(default: the one with build.ninja here or in the root)")
    s.add_argument("--root", metavar="DIR", help="source root (default: the "
                   "git work tree)")
    s.add_argument("--name", help="config name (default: the root's name)")
    s.add_argument("--exclude", action="append", metavar="NAMES",
                   help="more top-level names not to sync")
    s.add_argument("--extra", action="append", metavar="DIRS",
                   help="more trees to sync whole")
    s.add_argument("--local-jobs", type=int, metavar="N")
    s.add_argument("--port", type=int)
    s.add_argument("--client-addr", metavar="ADDR")
    s.add_argument("--prefix")
    s.add_argument("--set", action="append", metavar="KEY=VALUE",
                   help="extra variable to export to the build")
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_init)

    s = sub.add_parser("show", help="print the config and environment")
    s.set_defaults(fn=cmd_show)
    s = sub.add_parser("env", help="print export lines for eval")
    s.set_defaults(fn=cmd_env)
    s = sub.add_parser("run", help="run a command with the environment")
    s.add_argument("command", nargs=argparse.REMAINDER)
    s.set_defaults(fn=cmd_run)
    s = sub.add_parser("shell", help="start a shell with the environment")
    s.set_defaults(fn=cmd_shell)

    s = sub.add_parser("sync", help="copy the tree to the helpers")
    s.add_argument("host", nargs="*", help="ssh names (default: all)")
    s.set_defaults(fn=cmd_sync)

    s = sub.add_parser("build", help="build PCHs, sync, then ninja")
    s.add_argument("-C", dest="build_dir", metavar="DIR",
                   help="build directory (default: BUILD_DIR)")
    s.add_argument("--no-sync", action="store_true")
    s.add_argument("--no-pch", action="store_true")
    s.add_argument("ninja_args", nargs=argparse.REMAINDER,
                   help="passed to ninja (e.g. a target, -j8)")
    s.set_defaults(fn=cmd_build)

    s = sub.add_parser("test", help="compile a few files through the "
                       "mirror and compare with local compiles")
    s.add_argument("-n", "--count", type=int, default=5)
    s.add_argument("-C", dest="build_dir", metavar="DIR")
    s.add_argument("--match", action="append", metavar="TEXT",
                   help="only files whose path contains TEXT")
    s.add_argument("--helper", action="append", metavar="SSH")
    s.add_argument("--seed", type=int)
    s.add_argument("--no-compare", action="store_true",
                   help="skip the local compiles")
    s.set_defaults(fn=cmd_test)

    s = sub.add_parser("doctor", help="check this machine and the helpers")
    s.set_defaults(fn=cmd_doctor)

    s = sub.add_parser("helper", help="manage the daemon on the helpers")
    s.add_argument("action", choices=["install", "start", "stop", "restart",
                                      "status", "log", "uninstall"])
    s.add_argument("host", nargs="*", help="ssh names (default: all)")
    s.add_argument("-n", "--lines", type=int, default=50,
                   help="log lines to show")
    s.set_defaults(fn=cmd_helper)

    s = sub.add_parser("brew-parity", help="compare Homebrew with the "
                       "helpers and copy missing kegs")
    s.add_argument("host", nargs="*")
    s.add_argument("--apply", action="store_true",
                   help="copy the missing kegs, link and pin them")
    s.add_argument("--different", action="store_true",
                   help="with --apply, also replace kegs at other versions")
    s.add_argument("--only", action="append", metavar="NAMES",
                   help="only these formulae (comma-separated)")
    s.set_defaults(fn=cmd_brew_parity)

    args = p.parse_args()
    if not getattr(args, "fn", None):
        p.print_help()
        sys.exit(2)
    try:
        args.fn(args)
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        # Output piped into head and the like.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(1)


if __name__ == "__main__":
    main()
