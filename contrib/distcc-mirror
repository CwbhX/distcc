def do_sync(cfg, hosts=()):
    if not os.path.exists(cfg.distcc()):
        die("%s is missing; run distcc-mirror install" % cfg.distcc())
    r = subprocess.run([cfg.distcc(), "--mirror-sync"] + list(hosts),
                       env=cfg.full_env())
    if r.returncode != 0:
        die("sync failed", r.returncode)


def cmd_sync(args):
    cfg = load_config(args)
    step("Syncing to %s" % (" ".join(args.host)
                            or " ".join(h.ssh for h in cfg.helpers)))
    do_sync(cfg, args.host)


def pch_targets(build_dir, env):
    r = subprocess.run(["ninja", "-C", build_dir, "-t", "targets", "all"],
                       capture_output=True, text=True, env=env)
    out = []
    for line in r.stdout.splitlines():
        m = re.match(r"^(.*\.(?:pch|gch)): ", line)
        if m:
            out.append(m.group(1))
    return out


def cmd_build(args):
    cfg = load_config(args)
    build = os.path.abspath(args.build_dir or cfg.build_dir or ".")
    env = cfg.full_env()
    rest = list(args.ninja_args)
    if rest and rest[0] == "--":
        rest = rest[1:]
    ninja = os.path.exists(os.path.join(build, "build.ninja"))
    if not ninja and not os.path.exists(os.path.join(build, "Makefile")):
        die("no build.ninja or Makefile in %s" % build)
    t0 = time.time()
    if ninja and not args.no_pch:
        pchs = pch_targets(build, env)
        if pchs:
            # The helpers compile against copies of the PCHs, so they are
            # built (locally) and synced before anything else.
            step("Building %d precompiled headers" % len(pchs))
            run(["ninja", "-C", build] + pchs, env=env)
    if not args.no_sync:
        step("Syncing to %s" % " ".join(h.ssh for h in cfg.helpers))
        do_sync(cfg)
    t1 = time.time()
    has_j = any(a.startswith("-j") for a in rest)
    jobs = [] if has_j else ["-j%d" % cfg.total_jobs()]
    tool = ["ninja", "-C", build] if ninja else ["make", "-C", build]
    step("Building (%s)" % (" ".join(jobs + rest) or "all"))
    r = subprocess.run(tool + jobs + rest, env=env)
    t2 = time.time()
    info("\ndistcc-mirror: preparation %.1fs, build %.1fs, total %.1fs"
         % (t1 - t0, t2 - t1, t2 - t0))
    sys.exit(r.returncode)


# ---------------------------------------------------------------- test

LAUNCHERS = ("ccache", "sccache", "distcc")


def compile_entries(build_dir):
    p = os.path.join(build_dir, "compile_commands.json")
    if not os.path.exists(p):
        die("no compile_commands.json in %s (configure with "
            "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON)" % tilde(build_dir))
    with open(p) as f:
        db = json.load(f)
    out = []
    for e in db:
        argv = e.get("arguments") or shlex.split(e["command"])
        while argv and os.path.basename(argv[0]) in LAUNCHERS:
            argv = argv[1:]
        joined = " ".join(argv)
        if "-emit-pch" in joined or re.search(r"-x\s*\S*-header", joined):
            continue
        out.append((e["directory"], e["file"], argv))
    return out


def retarget(argv, obj, dep):
    """argv with the object and dependency file moved to @p obj, @p dep."""
    out, i = [], 0
    while i < len(argv):
        a = argv[i]
        if a in ("-o", "-MF") and i + 1 < len(argv):
            out += [a, obj if a == "-o" else dep]
            i += 2
            continue
        if a.startswith("-o") and len(a) > 2:
            out.append("-o" + obj)
        elif a.startswith("-MF") and len(a) > 3:
            out.append("-MF" + dep)
        elif a in ("--serialize-diagnostics", "-MJ") and i + 1 < len(argv):
            i += 2
            continue
        else:
            out.append(a)
        i += 1
    return out


def classify(log):
    """What happened to a mirrored job, from distcc's verbose log."""
    reasons = [l.split("mirror: ", 1)[1] for l in log.splitlines()
               if "mirror: " in l and "mirror: checked " not in l]
    m = re.search(r"mirror: MIRR (\d+): (.*)", log)
    if "compiled in the mirror on" in log:
        return "mirrored", ""
    if m:
        return "refused (MIRR %s)" % m.group(1), m.group(2)
    if "differs from the helper's copy" in log:
        r = re.search(r"mirror: (.*) differs from the helper's copy", log)
        return "rejected", "%s differs" % (r.group(1) if r else "a file")
    if re.search(r"compile of .* failed on", log):
        return "failed in mirror", ""
    if "outside DISTCC_MIRROR_ROOTS" in log:
        return "not mirrored", "cwd outside ROOTS"
    if "still in backoff period" in log:
        return "not mirrored", ("the helper is in backoff after a failed "
                                "job; it is retried after a minute")
    return "not mirrored", reasons[-1] if reasons else ""


def cmd_test(args):
    cfg = load_config(args)
    build = os.path.abspath(args.build_dir or cfg.build_dir or ".")
    entries = compile_entries(build)
    if args.match:
        entries = [e for e in entries if any(m in e[1] for m in args.match)]
    if not entries:
        die("no matching compile commands")
    rnd = random.Random(args.seed)
    pick = entries if len(entries) <= args.count else rnd.sample(
        entries, args.count)
    helpers = [h for h in cfg.helpers
               if not args.helper or h.ssh in args.helper]
    if not helpers:
        die("no such helper")
    h = helpers[0]
    if not port_open(h.addr, h.port):
        die("%s:%d does not answer; start it with: distcc-mirror helper "
            "install" % (h.addr, h.port))
    env = cfg.full_env()
    env.pop("DISTCC_LOG", None)
    env["DISTCC_HOSTS"] = "%s:%d/4,mirror" % (h.addr, h.port)
    env["DISTCC_VERBOSE"] = "1"
    step("Compiling %d file(s) on %s through the mirror%s"
         % (len(pick), h.ssh, "" if args.no_compare
            else ", and locally to compare"))
    tmp = tempfile.mkdtemp(prefix="distcc-mirror-test.")
    counts = {}
    different = 0
    try:
        for directory, src, argv in pick:
            obj = os.path.join(tmp, "out.o")
            dep = os.path.join(tmp, "out.d")
            cmd = retarget(argv, obj, dep)
            t0 = time.time()
            r = subprocess.run([cfg.distcc()] + cmd, cwd=directory, env=env,
                               capture_output=True, text=True)
            secs = time.time() - t0
            what, why = classify(r.stderr)
            if r.returncode != 0:
                what, why = "compile error", r.stderr.strip().splitlines()[-1]
            same = ""
            if not args.no_compare and r.returncode == 0:
                os.rename(obj, obj + ".mirror")
                l = subprocess.run(cmd, cwd=directory, capture_output=True)
                if l.returncode == 0:
                    with open(obj, "rb") as a, open(obj + ".mirror", "rb") as b:
                        if a.read() == b.read():
                            same = "identical"
                        else:
                            same = "OBJECT DIFFERS"
                            different += 1
            counts[what] = counts.get(what, 0) + 1
            color = "32" if what == "mirrored" else "33"
            rel = src
            for root in cfg.roots:
                if under(src, root):
                    rel = os.path.relpath(src, root)
            info("  %s %5.1fs  %s%s" % (
                _c(color, "%-17s" % what), secs, rel,
                ("  [%s]" % _c("31" if "DIFF" in same else "2", same))
                if same else ""))
            if why:
                info("      " + _c("2", why))
            for f in (obj, obj + ".mirror", dep):
                if os.path.exists(f):
                    os.remove(f)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    info("")
    info("summary: " + ", ".join("%d %s" % (n, w)
                                 for w, n in sorted(counts.items())))
    if counts.get("mirrored", 0) < len(pick):
        info("Jobs that were not mirrored still built correctly (the "
             "classic way).  If\nmany are rejected, run distcc-mirror sync, "
             "then distcc-mirror doctor.")
    if different:
        die("%d object(s) differ from a local compile" % different)


# ---------------------------------------------------------------- doctor

def cmd_doctor(args):
    cfg = load_config(args)
    rep = Report()
    step("This machine (%s)" % tilde(cfg.path))
    dirs = cfg.roots + cfg.extra
    lf = local_facts(cfg, dirs)
    distcc = cfg.distcc()
    if lf.get("distcc") == "missing" or lf.get("distccd") == "missing":
        rep.fail("distcc is not installed in %s" % tilde(cfg.prefix),
                 "contrib/distcc-mirror install (from the distcc source tree)")
    else:
        h = subprocess.run([distcc, "--help"], capture_output=True,
                           text=True)
        if "--mirror-sync" not in (h.stdout + h.stderr):
            rep.fail("%s has no mirror mode" % tilde(distcc),
                     "contrib/distcc-mirror install")
        else:
            rep.ok("distcc with mirror mode in %s" % tilde(cfg.bindir()))
    for d in lf.all("dir_missing"):
        rep.fail("%s does not exist" % tilde(d))
    if cfg.build_dir:
        b = cfg.build_dir
        if not os.path.isdir(b):
            rep.fail("build dir %s does not exist" % tilde(b))
        else:
            if not any(under(b, r) for r in cfg.roots):
                rep.fail("build dir %s is not under ROOTS" % tilde(b))
            else:
                rep.ok("build dir %s%s" % (tilde(b), (
                    " (really %s)" % tilde(os.path.realpath(b)))
                    if os.path.realpath(b) != b else ""))
            launcher = cmake_launcher(b)
            if launcher is None:
                pass
            elif launcher == "":
                rep.warn("the build has no compiler launcher, so it does not "
                         "use distcc", "cmake -DCMAKE_C_COMPILER_LAUNCHER="
                         "distcc -DCMAKE_CXX_COMPILER_LAUNCHER=distcc "
                         + tilde(b))
            elif "ccache" in launcher:
                cp = cfg.extra_env.get("CCACHE_PREFIX")
                if not cp:
                    rep.warn("the build uses ccache but CCACHE_PREFIX is not "
                             "set, so nothing is distributed",
                             "add CCACHE_PREFIX=%s to %s"
                             % (tilde(distcc), tilde(cfg.path)))
                else:
                    rep.ok("ccache hands jobs to %s" % tilde(cp))
            else:
                rep.ok("compiler launcher: %s" % launcher)
    if not shutil.which("rsync"):
        rep.fail("rsync is not installed")

    for h in cfg.helpers:
        step("Helper %s (%s:%d)" % (h.ssh, h.addr, h.port))
        hf, err = helper_facts(cfg, h, dirs)
        if hf is None:
            rep.fail("cannot ssh to %s: %s" % (h.ssh, err),
                     "check that 'ssh %s' works without a password"
                     % h.ssh)
            continue
        rep.ok("ssh works (macOS %s, %s, %s cores)"
               % (hf.get("os"), hf.get("arch"), hf.get("ncpu")))
        if hf.get("arch") != lf.get("arch"):
            rep.fail("architecture %s differs from this machine's %s"
                     % (hf.get("arch"), lf.get("arch")))
        if hf.get("distccd") == "missing":
            rep.fail("distcc is not installed on %s" % h.ssh,
                     "distcc-mirror install --no-build --helper " + h.ssh)
        elif hf.get("distccd") != lf.get("distccd"):
            rep.warn("its distccd differs from this machine's build",
                     "distcc-mirror install --no-build --helper " + h.ssh)
        else:
            rep.ok("same distcc build as here")
        wl = hf.get("whitelist").split()
        if not {"clang", "clang++"} <= set(wl):
            rep.fail("the compiler whitelist (%s/lib/distcc) lacks clang"
                     % tilde(cfg.prefix),
                     "distcc-mirror install --no-build --helper " + h.ssh)
        if not hf.get("clang"):
            rep.fail("no clang (Command Line Tools) on %s" % h.ssh)
        elif hf.get("clang") != lf.get("clang"):
            rep.fail("the compiler differs (here: %s / CLT %s; there: %s / "
                     "CLT %s): every job would fall back (MIRR 6)"
                     % (lf.get("clang_version"), lf.get("clt"),
                        hf.get("clang_version"), hf.get("clt")),
                     "install the same Command Line Tools on both")
        else:
            rep.ok("same compiler (%s)" % hf.get("clang_version"))
        if hf.get("sdk") != lf.get("sdk"):
            rep.fail("SDK %s differs from this machine's %s"
                     % (hf.get("sdk"), lf.get("sdk")))
        missing = hf.all("dir_missing")
        for d in missing:
            fix = "distcc-mirror sync" if d in cfg.roots + cfg.extra else None
            rep.fail("%s is missing there" % tilde(d), fix)
        if not missing:
            rep.ok("roots and extra trees are present (run distcc-mirror "
                   "sync before building)")

        daemon = hf.get("daemon")
        agent = hf.get("agent")
        if not daemon:
            rep.fail("no daemon on port %d" % h.port,
                     "distcc-mirror helper install")
        else:
            roots_missing = [r for r in cfg.roots
                             if "--mirror-root %s" % r not in daemon]
            if roots_missing:
                rep.fail("the daemon does not serve %s"
                         % " ".join(tilde(r) for r in roots_missing),
                         "distcc-mirror helper install")
            elif agent in ("none", ""):
                rep.warn("the daemon was started by hand and will not "
                         "survive a reboot", "distcc-mirror helper install")
            else:
                rep.ok("daemon running (LaunchAgent %s)" % label(h.port))
        if port_open(h.addr, h.port):
            rep.ok("%s:%d answers" % (h.addr, h.port))
        elif daemon:
            rep.fail("%s:%d does not answer from here" % (h.addr, h.port),
                     "check --listen/--allow (CLIENT_ADDR=%s)"
                     % cfg.client_addr)

        lk, hk = lf.kegs(), hf.kegs()
        if lk:
            hc = hf.cellar()
            miss = sorted(n for n in lk if n not in hk
                          and "%s/%s" % (n, lk[n]) not in hc)
            noopt = sorted(n for n in lk if n not in hk
                           and "%s/%s" % (n, lk[n]) in hc)
            diff = sorted(n for n in lk if n in hk and hk[n] != lk[n])
            if noopt:
                rep.warn("%d kegs are there but have no /opt/homebrew/opt "
                         "link (%s)" % (len(noopt), ", ".join(noopt)),
                         "distcc-mirror brew-parity --apply")
            inc_l = set(lf.get("include").split())
            inc_h = set(hf.get("include").split())
            if miss or diff:
                rep.warn("Homebrew differs: %d formulae missing there%s, %d "
                         "at other versions%s" % (
                             len(miss), (" (%s%s)" % (", ".join(miss[:6]),
                                          ", ..." if len(miss) > 6 else ""))
                             if miss else "",
                             len(diff), (" (%s)" % ", ".join(
                                 "%s %s/%s" % (n, lk[n], hk[n])
                                 for n in diff[:4])) if diff else ""),
                         "distcc-mirror brew-parity  (jobs reading those "
                         "headers fall back)")
            else:
                rep.ok("Homebrew: the same %d formulae at the same versions"
                       % len(lk))
            if inc_l != inc_h:
                only = sorted(inc_l ^ inc_h)
                rep.warn("/opt/homebrew/include differs: %s%s"
                         % (", ".join(only[:6]),
                            ", ..." if len(only) > 6 else ""))

    info("")
    if rep.problems:
        die("%d problem(s), %d warning(s)" % (rep.problems, rep.warnings))
    info(_c("32", "All good") + ("" if not rep.warnings else
                                 " (%d warning(s))" % rep.warnings))


# ---------------------------------------------------------------- helper

def daemon_plan(cfg, h):
    """The daemon's settings for helper @p h: the union over every config
    that names the same helper and port."""
    roots, allows, jobs, extra = [], [], h.jobs, list(cfg.daemon_args)
    for p in all_config_paths() + [cfg.path]:
        try:
            c = cfg if p == cfg.path else Config(p)
        except SystemExit:
            continue
        if c.port != cfg.port or h.ssh not in [x.ssh for x in c.helpers]:
            continue
        for r in c.roots:
            if r not in roots:
                roots.append(r)
        if c.client_addr and c.client_addr not in allows:
            allows.append(c.client_addr)
        jobs = max(jobs, max(x.jobs for x in c.helpers if x.ssh == h.ssh))
    if not allows:
        die("CLIENT_ADDR is not set in %s (this machine's address as the "
            "helper sees it)" % tilde(cfg.path))
    return roots, allows, jobs, extra


